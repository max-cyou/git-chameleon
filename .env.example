# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# GitHub App credentials (Settings -> Developer settings -> GitHub Apps)
# GITHUB_APP_CLIENT_ID shown on the app's About page
GITHUB_APP_CLIENT_ID=your_client_id
# Path to the private key you download from the app page
GITHUB_APP_PRIVATE_KEY_PATH=/etc/git-chameleon/private-key.pem

# SQLite database file
DATABASE_PATH=data/bot.db

# LLM provider (OpenAI-compatible API): chat replies and PR review summaries
# Example: https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO